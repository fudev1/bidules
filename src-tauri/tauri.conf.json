{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bidule",
  "version": "0.1.0",
  "identifier": "com.bidule.desktoptest",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bidule",
        "width": 176,
        "height": 176,
        "x": 600,
        "y": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "backgroundThrottling": "disabled",
        "focus": false
      },
      {
        "label": "panel",
        "title": "Bidule",
        "url": "panel.html",
        "width": 520,
        "height": 600,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}